---
import { siteConfig } from '../config/site';
---
<section class="nameservers" aria-labelledby="nameservers-title">
  <div class="nameservers-heading">
    <h2 id="nameservers-title">Get started with the free public nameservers</h2>
  </div>
  <p class="nameservers-intro">Set these at your domain provider. No signup or further configuration required.</p>
  <button class="copy-button" data-copy-nameservers hidden>Copy all <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" /></svg></button>
  <ul class="nameserver-list" data-nameservers>
    {siteConfig.nameservers.map((nameserver) => <li><code>{nameserver}</code></li>)}
  </ul>
  <p class="copy-status" role="status" aria-live="polite" data-copy-status></p>
</section>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy-nameservers]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  if (button && status && navigator.clipboard?.writeText) {
    button.hidden = false;
    button.addEventListener('click', async () => {
      const nameservers = Array.from(document.querySelectorAll('[data-nameservers] code'), (node) => node.textContent).join('\n');
      try {
        await navigator.clipboard.writeText(nameservers);
        status.textContent = 'All four nameservers copied.';
      } catch {
        status.textContent = 'Copy unavailable. Select the nameservers above and copy them manually.';
      }
    });
  }
</script>
